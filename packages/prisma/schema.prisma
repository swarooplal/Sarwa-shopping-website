// SARWA Prisma Schema (SQLite for local dev; switch to "postgresql" for prod).
// Array fields are stored as JSON strings to support SQLite; the serializer
// converts them on read in apps/backend/src/utils/serialize.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── AUTH & USERS ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  firstName     String?
  lastName      String?
  phone         String?   @unique
  avatar        String?
  role          String    @default("CUSTOMER") // ADMIN | MANAGER | EDITOR | STAFF | CUSTOMER
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens     RefreshToken[]
  addresses         Address[]
  orders            Order[]
  cart              Cart?
  wishlist          WishlistItem[]
  reviews           Review[]
  blogComments      BlogComment[]
  couponRedemptions CouponRedemption[]
  searchHistory     SearchHistory[]
  passwordResets    PasswordReset[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
}

// ─── CATALOG ──────────────────────────────────────────────────────────────

model Category {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  description    String?
  image          String?
  banner         String?
  parentId       String?
  sortOrder      Int        @default(0)
  isVisible      Boolean    @default(true)
  seoTitle       String?
  seoDescription String?

  parent         Category?  @relation("CategoryToChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[] @relation("CategoryToChildren")
  menuItems      MenuItem[]
  products       ProductOnCategory[]

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  type        String   // FEATURED | WEDDING | SILK | DAILY | OFFICE | PARTY | DESIGNER | JEWELLERY
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  products    ProductOnCollection[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  sku              String   @unique
  shortDescription String?
  description      String?
  price            Decimal
  offerPrice       Decimal?
  stock            Int      @default(0)
  brand            String?
  fabric           String?
  occasion         String?
  color            String?
  weight           Float?
  // String-array fields are stored as JSON for SQLite compatibility
  tagsJson         String   @default("[]")
  metaKeywordsJson String   @default("[]")
  video            String?
  seoTitle         String?
  seoDescription   String?

  isFeatured       Boolean  @default(false)
  isTrending       Boolean  @default(false)
  isNewArrival     Boolean  @default(false)
  isBestSeller     Boolean  @default(false)
  isActive         Boolean  @default(true)

  categories       ProductOnCategory[]
  collections      ProductOnCollection[]
  images           ProductImage[]
  variants         ProductVariant[]
  reviews          Review[]

  relatedFrom      ProductRelation[] @relation("ProductRelationFrom")
  relatedTo        ProductRelation[] @relation("ProductRelationTo")
  menuItems        MenuItemProduct[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([slug])
  @@index([sku])
  @@index([isActive, isFeatured])
}

model ProductOnCategory {
  productId  String
  categoryId String

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductOnCollection {
  productId    String
  collectionId String

  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  size      String
  sku       String
  stock     Int     @default(0)
  price     Float?

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductRelation {
  id             String @id @default(cuid())
  fromId         String
  toId           String
  type           String // RELATED | CROSS_SELL | UPSELL

  product        Product @relation("ProductRelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("ProductRelationTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, type])
}

// ─── MENUS ────────────────────────────────────────────────────────────────

model MenuItem {
  id           String   @id @default(cuid())
  label        String
  link         String?
  icon         String?
  parentId     String?
  // Reference the Category table directly so menus never duplicate category data.
  categoryId   String?
  // Legacy slug reference kept for backward compat with existing seeds; new writes prefer categoryId.
  categorySlug String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parent     MenuItem?  @relation("MenuToChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children   MenuItem[] @relation("MenuToChildren")
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  products   MenuItemProduct[]

  @@index([parentId, sortOrder])
  @@index([categoryId])
}

model MenuItemProduct {
  menuItemId String
  productId  String

  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([menuItemId, productId])
}

// ─── BANNERS ─────────────────────────────────────────────────────────────

model Banner {
  id           String   @id @default(cuid())
  position     String   @default("HERO")
  desktopImage String
  mobileImage  String?
  heading      String?
  subHeading   String?
  buttonText   String?
  buttonLink   String?
  startAt      DateTime?
  endAt        DateTime?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── CART / WISHLIST / ORDERS ─────────────────────────────────────────────

model Cart {
  id          String   @id @default(cuid())
  userId      String?  @unique
  guestId     String?  @unique
  couponCode  String?
  subtotal    Float    @default(0)
  discount    Float    @default(0)
  shipping    Float    @default(0)
  tax         Float    @default(0)
  total       Float    @default(0)
  items       CartItem[]
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CartItem {
  id          String  @id @default(cuid())
  cartId      String
  productId   String
  variantId   String?
  quantity    Int     @default(1)
  size        String?
  unitPrice   Float

  cart        Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id               String   @id @default(cuid())
  orderNumber      String   @unique
  userId           String?
  guestEmail       String?
  subtotal         Float
  discount         Float    @default(0)
  shipping         Float    @default(0)
  tax              Float    @default(0)
  total            Float
  status           String   @default("PENDING")
  paymentStatus    String   @default("PENDING")
  paymentMethod    String
  notes            String?

  shippingAddressId String?
  shippingAddress   Address? @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id])

  items            OrderItem[]
  timeline         OrderTimeline[]

  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  variantId   String?
  name        String
  sku         String?
  size        String?
  unitPrice   Float
  quantity    Int
  total       Float
  image       String?

  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderTimeline {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  note      String?
  at        DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Address {
  id        String   @id @default(cuid())
  userId    String?
  label     String?
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]  @relation("OrderShippingAddress")
}

// ─── COUPONS ─────────────────────────────────────────────────────────────

model Coupon {
  id               String   @id @default(cuid())
  code             String   @unique
  type             String   // PERCENTAGE | FLAT
  value            Float
  minPurchase      Float?
  expiry           DateTime?
  usageLimit       Int?
  perCustomerLimit Int?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  redemptions      CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String?
  createdAt DateTime @default(now())

  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── REVIEWS / BLOG / CMS ────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  userName  String
  rating    Int
  title     String?
  comment   String
  status    String   @default("PENDING")
  reply     String?
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status])
}

model BlogCategory {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  posts     BlogPost[]
}

model BlogTag {
  id    String        @id @default(cuid())
  name  String        @unique
  slug  String        @unique
  posts BlogPostTag[]
}

model BlogPost {
  id             String       @id @default(cuid())
  title          String
  slug           String       @unique
  excerpt        String?
  content        String
  coverImage     String?
  categoryId     String?
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean      @default(false)
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  category       BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags           BlogPostTag[]
  comments       BlogComment[]
}

model BlogPostTag {
  postId String
  tagId  String

  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model BlogComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String?
  name      String
  email     String
  content   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model CmsPage {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  content        String
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── SEARCH / NEWSLETTER / CONTACT ───────────────────────────────────────

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String?
  query     String
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([query])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── MEDIA / ANALYTICS ───────────────────────────────────────────────────

model Media {
  id        String   @id @default(cuid())
  url       String
  filename  String
  mimeType  String
  size      Int
  bucket    String?
  key       String?
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  payload   String?
  ip        String?
  userAgent String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
