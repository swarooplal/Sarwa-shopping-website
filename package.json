{
  "name": "sarwa",
  "version": "1.0.0",
  "private": true,
  "description": "SARWA - Luxury Indian Saree & Jewellery eCommerce Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/backend\" \"npm run dev --workspace=apps/frontend\"",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=apps/backend && npm run build --workspace=apps/frontend",
    "db:generate": "npm run prisma:generate --workspace=packages/prisma",
    "db:push": "npm run prisma:push --workspace=packages/prisma",
    "db:migrate": "npm run prisma:migrate --workspace=packages/prisma",
    "db:seed": "npm run prisma:seed --workspace=packages/prisma"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.10.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
